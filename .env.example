# ============================================================
# Scratch'n'Travel — Umgebungsvariablen (VORLAGE)
# ============================================================
# Kopiere diese Datei nach `.env` und trage die echten Werte ein.
# NIEMALS die echten Werte committen — `.env` steht in `.gitignore`.
# Diese Datei darf ausschließlich Platzhalter enthalten.
# ============================================================


# ---------- Supabase (Auth + Datenbank) ----------
# Erforderlich für Login, Profile, Secret Spots, Nachrichten, Meetups.
# Projekt-URL: Supabase Dashboard → Project Settings → API → Project URL (z.B. https://xyz.supabase.co)
# Publishable/Anon Key: Supabase Dashboard → Project Settings → API → anon public oder Publishable Key (sb_publishable_...)
#
# WICHTIG:
# - VITE_SUPABASE_URL MUSS immer eine HTTPS-Adresse sein (z.B. https://[project-ref].supabase.co)!
# - VITE_SUPABASE_ANON_KEY unterstützt sowohl die neuen Publishable Keys (sb_publishable_...)
#   als auch traditionelle JWT anon-Keys.
# - SUPABASE_SERVICE_KEY unterstützt sowohl die neuen Secret Keys (sb_secret_...)
#   als auch traditionelle JWT service_role Keys. Niemals mit VITE_ ins Frontend geben!
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Nur für Server/CI-Skripte (niemals ins Frontend):
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...


# ---------- Stripe (Abos + Merchandise) ----------
# Dashboard → Developers → API keys
# Unterstützt Live Publishable Keys (pk_live_...) und Secret / Restricted Keys (rk_live_... / sk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=rk_live_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...


# ---------- Printful / Printify / Gelato (Print on Demand) ----------
# POD/Merch ist seit 2026-10-06 im UI VERSTECKT (Owner-Entscheidung: erst
# öffnen, wenn Nutzer da sind). Ohne VITE_POD_ENABLED=true wird der Shop
# (Merch-Kategorie, Bestell-Sektion, Pricing-Rabatt) nicht gerendert.
# Öffnen = diese Zeile auf `true` setzen + Deploy auslösen, kein Code-Change.
VITE_POD_ENABLED=
PRINTFUL_KEY=
PRINTFUL_STORE_ID=
PRINTIFY_KEY=
PRINTIFY_STORE_ID=
GELATO_KEY=


# ---------- AI-Provider (Hermes Concierge Multi-Provider Gateway) ----------
# Es muss mindestens EINER gesetzt sein, sonst antwortet der Concierge
# mit 503 AI_NOT_CONFIGURED oder dem deterministischen Offline-Fallback.
# Alle Schlüssel ausschließlich als Server-Env setzen, NIEMALS im Quellcode.
REQUESTY_API_KEY=
EDEN_API_KEY=
OPENROUTER_API_KEY=
ZENMUX_API_KEY=
TOGETHERAI_API_KEY=
ORCAROUTER_API_KEY=
OLLAMA_API_KEY=
CEREBRAS_API_KEY=
VERCEL_AI_KEY=
CLOUDFLARE_API_TOKEN=


# ---------- Organisation ----------
ORGANIZATION=


# ---------- Optional: Funktionsschalter ----------
# Wenn NICHT gesetzt, läuft die App im sicheren Normalbetrieb.
# Auf "true" nur für lokale Entwicklung / Demos setzen.
# VITE_DEMO_MODE=true

# Öffentliche Basis-URL (für Canonical, Sitemap, OG-Tags)
VITE_SITE_URL=https://scratch-n-travel.vercel.app
