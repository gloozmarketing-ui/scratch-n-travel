# ============================================================
# Scratch'n'Travel — Umgebungsvariablen (VORLAGE)
# ============================================================
# Kopiere diese Datei nach `.env` und trage die echten Werte ein.
# NIEMALS die echten Werte committen — `.env` steht in `.gitignore`.
# Diese Datei darf ausschließlich Platzhalter enthalten.
# ============================================================


# ---------- Supabase (Auth + Datenbank) ----------
# Erforderlich für Login, Profile, Secret Spots, Nachrichten, Meetups.
# Projekt-URL: Supabase Dashboard → Project Settings → API
# Anon Key:   Supabase Dashboard → Project Settings → API → anon public
#
# WICHTIG: Der "anon public" Key ist für Browser-Code gedacht und wird durch
# Row-Level-Security geschützt. Es ist OK, ihn in VITE_-Variablen zu verwenden.
# NIEMALS den "service_role" Key im Frontend verwenden!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nur für Server/CI-Skripte (niemals ins Frontend):
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# ---------- Stripe (Abos + Merchandise) ----------
# Dashboard → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ---------- Printful / Printify (Print on Demand) ----------
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
PRINTIFY_API_KEY=
PRINTIFY_STORE_ID=


# ---------- AI-Provider (Hermes Concierge) ----------
# Es muss mindestens EINER gesetzt sein, sonst antwortet der Concierge
# mit 503 AI_NOT_CONFIGURED (fail-closed, kein kostenpflichtiger Blind-Call).
# Alle Schlüssel ausschließlich als Server-Env setzen, NIEMALS im Quellcode.
ZENMUX_API_KEY=
REQUESTY_API_KEY=
CEREBRAS_API_KEY=
VERCEL_AI_KEY=
CLOUDFLARE_API_TOKEN=
OLLAMA_CLOUD_KEY=


# ---------- Organisation ----------
ORGANIZATION=


# ---------- Optional: Funktionsschalter ----------
# Wenn NICHT gesetzt, läuft die App im sicheren Normalbetrieb.
# Auf "true" nur für lokale Entwicklung / Demos setzen.
# VITE_DEMO_MODE=true

# Öffentliche Basis-URL (für Canonical, Sitemap, OG-Tags)
VITE_SITE_URL=https://scratch-n-travel.vercel.app
